# ============================================================
# ChatBackend — Environment Variables
# ============================================================

# ── LLM ──────────────────────────────────────────────────────
LLM__Provider=Groq
LLM__Groq__ApiKey=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY
LLM__Groq__Model=llama3-8b-8192

# ── Meta WhatsApp Cloud API ───────────────────────────────────
# Get these from: developers.facebook.com → your app → WhatsApp → API Setup
META__ACCESSTOKEN=EAAxxxxxxxxxxxxx       # System User permanent token
META__PHONENUMBERID=123456789012345     # Phone Number ID (not the phone number itself)
META__VERIFYTOKEN=my_secret_verify_token # Any string you choose — paste same in Meta webhook UI

# ── Database ──────────────────────────────────────────────────
CONNECTIONSTRINGS__SQLITE=Data Source=chat.db

# ── ASP.NET Core ──────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
