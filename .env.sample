# ============================================================
# ChatBackend — Environment Variables
# ============================================================

# ── LLM ──────────────────────────────────────────────────────
LLM__Groq__ApiKey=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY
LLM__Groq__Model=openai/gpt-oss-120b

# ── Meta WhatsApp Cloud API ───────────────────────────────────
# Get these from: developers.facebook.com → your app → WhatsApp → API Setup
META__ACCESSTOKEN=EAAxxxxxxxxxxxxx       # System User permanent token
META__PHONENUMBERID=123456789012345     # Phone Number ID
META__VERIFYTOKEN=my_secret_verify_token # Webhook handshake verification token
META__APPSECRET=my_meta_app_secret       # App Secret for webhook HMAC-SHA256 signature verification

# ── Chat Budget & Sliding Window ──────────────────────────────
CHAT__MAXHISTORYMESSAGES=20

# ── Database ──────────────────────────────────────────────────
CONNECTIONSTRINGS__SQLITE=Data Source=chat.db

# ── ASP.NET Core ──────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
